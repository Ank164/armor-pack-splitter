<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Mutagen.Bethesda.Kernel</id>
    <version>0.53.1</version>
    <authors>Noggog</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="expression">GPL-3.0-only</license>
    <licenseUrl>https://licenses.nuget.org/GPL-3.0-only</licenseUrl>
    <projectUrl>https://github.com/Mutagen-Modding/Mutagen</projectUrl>
    <description>A C# library containing the very minimal basics about Bethesda structures.  Meant to be a lightweight import with some basic definitions</description>
    <releaseNotes>Bethesda Modding</releaseNotes>
    <copyright>2024</copyright>
    <repository type="git" url="https://github.com/Mutagen-Modding/Mutagen" branch="main" commit="bdbb6ff6faad3b4c3b0689e98e889ecd205068c8" />
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="Noggog.CSharpExt" version="4.1.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="Noggog.CSharpExt" version="4.1.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net10.0">
        <dependency id="Noggog.CSharpExt" version="4.1.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>