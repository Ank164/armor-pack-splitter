<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Loqui</id>
    <version>3.2.0</version>
    <authors>Noggog</authors>
    <description>Support wiring for Loqui generated classes</description>
    <repository type="git" url="https://github.com/Noggog/Loqui" branch="main" commit="a370205845bfe2e23749f31304a5fc9ee3d30ee0" />
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="Noggog.CSharpExt" version="3.1.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="Noggog.CSharpExt" version="3.1.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net10.0">
        <dependency id="Noggog.CSharpExt" version="3.1.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Noggog.CSharpExt" version="3.1.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>