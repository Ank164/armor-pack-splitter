<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>StrongInject</id>
    <version>1.4.4</version>
    <authors>StrongInject</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>logo-circle.png</icon>
    <projectUrl>https://github.com/YairHalberstadt/stronginject</projectUrl>
    <description>compile time dependency injection for C#</description>
    <repository type="git" url="https://github.com/YairHalberstadt/stronginject" commit="6f3077c68b1ebd9c56663456efb67ef90886942e" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Microsoft.Bcl.AsyncInterfaces" version="1.1.1" exclude="Build,Analyzers" />
        <dependency id="System.Collections.Immutable" version="5.0.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="System.Collections.Immutable" version="5.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>