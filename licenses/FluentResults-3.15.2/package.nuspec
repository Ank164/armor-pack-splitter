<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>FluentResults</id>
    <version>3.15.2</version>
    <authors>Michael Altmann</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>FluentResults-Icon-128.png</icon>
    <projectUrl>https://github.com/altmann/FluentResults</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/altmann/FluentResults/master/resources/icons/FluentResults-Icon-128.png</iconUrl>
    <description>A lightweight Result object implementation for .NET</description>
    <releaseNotes>FIXED - Result get packed twice because of implicit conversion to Result of object #165</releaseNotes>
    <copyright>Copyright 2022 (c) Michael Altmann. All rights reserved.</copyright>
    <tags>Result Results exception error handling</tags>
    <repository type="git" url="https://github.com/altmann/FluentResults" commit="8b675de7e8b6e4c0921e95138c99e15fd52cde40" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Microsoft.Extensions.Logging.Abstractions" version="6.0.1" exclude="Build,Analyzers" />
        <dependency id="System.Threading.Tasks.Extensions" version="4.5.4" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="Microsoft.Extensions.Logging.Abstractions" version="6.0.1" exclude="Build,Analyzers" />
        <dependency id="System.Threading.Tasks.Extensions" version="4.5.4" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>